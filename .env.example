# From @BotFather. The bot must be an admin of the channel so it can post.
TELEGRAM_BOT_TOKEN=
# Public channel: @channelname. Private channel: numeric id, e.g. -1001234567890
TELEGRAM_CHAT_ID=
# Forum topic id, or leave blank.
TELEGRAM_THREAD_ID=

# forgejo, gitea, gogs, github, or gitlab
FORGE=forgejo
# Site you open in a browser, with no trailing slash.
FORGE_WEB=https://forgejo.ekaii.fr
# API root, with no trailing slash.
#   forgejo / gitea / gogs: https://host/api/v1
#   github:                 https://api.github.com
#   gitlab:                 https://gitlab.com/api/v4
FORGE_API=https://forgejo.ekaii.fr/api/v1
FORGE_REPO=owner/name
# Branch to announce. Use * for every branch.
FORGE_BRANCH=main
# Leave blank for a public repo.
FORGE_TOKEN=

# Same string as the webhook secret on the forge.
WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook

# Seconds between backup polls. 0 turns polling off.
POLL_INTERVAL=60

# Where seen commit ids are stored so a restart does not re-post history.
STATE_PATH=data/state.json
